# 자동 다운로드하지 않는다. README의 수동 준비 절차를 따른다.
set(MO_CPP_NETWORK_SOURCE_DIR "${PROJECT_SOURCE_DIR}/third-party/cpp-network" CACHE PATH "cpp-network 소스 위치")
if(NOT EXISTS "${MO_CPP_NETWORK_SOURCE_DIR}/CMakeLists.txt")
    message(FATAL_ERROR "Prepare cpp-network first; see README socket session instructions.")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/network-dependencies.json" dependency_manifest)
string(JSON network_revision GET "${dependency_manifest}" cpp-network commit)
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${MO_CPP_NETWORK_SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE network_head OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE git_result)
if(NOT git_result EQUAL 0 OR NOT network_head STREQUAL network_revision)
    message(FATAL_ERROR "cpp-network HEAD must match ${network_revision}; do not reset local work. Update the manifest explicitly when upgrading.")
endif()
add_subdirectory("${MO_CPP_NETWORK_SOURCE_DIR}" "${PROJECT_BINARY_DIR}/cpp-network")
# 게임과 같은 검사 옵션으로 외부 구현도 계측한다.
if(mo_sanitizer_flags)
    target_compile_options(cpp_network PRIVATE ${mo_sanitizer_flags})
endif()
add_library(mo_socket_session server/net/socket_session.cpp)
add_library(mo::socket_session ALIAS mo_socket_session)
target_include_directories(mo_socket_session PUBLIC server/net)
target_link_libraries(mo_socket_session PUBLIC mo::session mo::transport cpp_network::transport)
add_executable(socket-session-demo server/apps/socket-session-demo/main.cpp)
target_link_libraries(socket-session-demo PRIVATE mo::socket_session)
if(BUILD_TESTING)
    add_executable(socket-session-tests tests/socket_session_tests.cpp)
    target_link_libraries(socket-session-tests PRIVATE mo::socket_session)
    foreach(case exchange fragmented pipelined rejection invalid timeouts shutdown stalled_client multithread)
        add_test(NAME socket_session.${case} COMMAND socket-session-tests ${case})
        set_tests_properties(socket_session.${case} PROPERTIES TIMEOUT 20)
    endforeach()
    add_test(NAME socket_session.demo COMMAND socket-session-demo)
    set_tests_properties(socket_session.demo PROPERTIES TIMEOUT 20)
endif()
